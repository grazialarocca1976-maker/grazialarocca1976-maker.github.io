<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista Spesa - Carne</title>
  <style>
    body { font-family: sans-serif; padding: 20px; }
    ul { list-style: none; padding: 0; }
    li {
      padding: 12px;
      margin-bottom: 8px;
      background: #f4f4f4;
      border-radius: 6px;
      cursor: pointer;
      user-select: none;
    }
    li.preso {
      text-decoration: line-through;
      color: #888;
      background: #e0e0e0;
    }
  </style>
</head>
<body>

  <a href="index.html">&larr; Torna al menù</a>
  <h1>Reparto Carne</h1>

  <ul id="lista-carne">
    <li onclick="this.classList.toggle('preso')">Petto di pollo</li>
    <li onclick="this.classList.toggle('preso')">Carne macinata</li>
    <li onclick="this.classList.toggle('preso')">Bistecche di manzo</li>
    <li onclick="this.classList.toggle('preso')">Prosciutto cotto</li>
  </ul>

</body>
</html>
